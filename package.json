{
  "name": "videocreation",
  "version": "1.0.0",
  "private": true,
  "description": "Reels animados de 1 minuto (1080x1920) generados con Claude + Remotion",
  "scripts": {
    "studio": "node scripts/emoji-assets.mjs && remotion studio",
    "sfx": "python3 scripts/make_sfx.py",
    "render": "node scripts/render.mjs",
    "reel": "node scripts/make_reel.mjs",
    "import": "bash -c '[ -d .venv ] || bash scripts/setup-python.sh; .venv/bin/python -I scripts/import_presentation.py \"$@\"' --",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@remotion/cli": "4.0.530",
    "@remotion/motion-blur": "^4.0.530",
    "@remotion/three": "4.0.530",
    "@remotion/transitions": "4.0.530",
    "@types/three": "0.170.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.530",
    "three": "0.170.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji": "^1.2.7",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@types/react": "18.3.12",
    "typescript": "5.6.3",
    "unicode-emoji-json": "^0.8.0"
  }
}
